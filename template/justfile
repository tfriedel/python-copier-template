# justfile for Python Project Template
# Usage: just <recipe>
# Use 'just --list' to see all available recipes

# Load environment variables from .env file
set dotenv-load := true

# Default recipe - show help
default: help

# Show this help message
help:
    @echo "Available recipes:"
    @just --list

## Setup and Installation

# Initialize a newly checked out repository
setup:
    @echo "🚀 Setting up development environment..."
    @just init-git
    @just install-probity
    @just install-dev
    @just install-hooks
    @echo "✅ Setup complete! You're ready to develop."

# Initialize git repository if needed
init-git:
    @if [ ! -d .git ]; then \
        echo "📁 Initializing Git repository..."; \
        git init; \
        echo "✅ Git repository initialized"; \
    else \
        echo "✅ Git repository already initialized"; \
    fi

# Install Probity (and Python ast-grep pack) for AI agent process discipline
# Installs locally via package.json so the probity.config.mjs Haiku override
# can resolve @anthropic-ai/claude-agent-sdk (a global install would not).
install-probity:
    @echo "🛡️ Installing/updating Probity..."
    @if command -v npm >/dev/null 2>&1; then \
        npm install --silent && \
        echo "✅ Probity installed locally (node_modules/)"; \
    else \
        echo "⚠️  npm not found - skipping Probity installation"; \
        echo "   Install Node.js to enable Probity: https://nodejs.org/"; \
    fi

# Install development dependencies
install-dev:
    @echo "📦 Installing development dependencies..."
    uv sync --dev

# Enable GitHub secret-scanning push protection on the current repo's remote.
# Push protection blocks pushes that contain detected secrets at GitHub's
# transport layer — the only layer that actually prevents a leak once the
# local hook is bypassed. Free for public repos and (since 2024) for private
# repos via GitHub's free secret-scanning tier. Requires `gh` authenticated
# with `admin:repo` scope and an `origin` remote pointing at GitHub.
enable-push-protection:
    @echo "🔒 Enabling GitHub secret-scanning push protection..."
    @if ! command -v gh >/dev/null 2>&1; then \
        echo "❌ gh CLI not found. Install: https://cli.github.com/"; exit 1; \
    fi
    @REMOTE=$(git remote get-url origin 2>/dev/null || true); \
    if [ -z "$REMOTE" ]; then \
        echo "❌ No 'origin' remote configured. Run 'gh repo create' first."; exit 1; \
    fi; \
    REPO=$(echo "$REMOTE" | sed -E 's#(git@github\.com:|https://github\.com/)([^/]+/[^/.]+)(\.git)?#\2#'); \
    echo "  → Target: $REPO"; \
    gh api -X PATCH "/repos/$REPO" \
        -F security_and_analysis[secret_scanning][status]=enabled \
        -F security_and_analysis[secret_scanning_push_protection][status]=enabled \
        --silent && \
    echo "✅ Push protection enabled for $REPO"

# Install pre-commit hooks
install-hooks:
    @echo "🪝 Installing pre-commit hooks..."
    @# Skip in worktrees - hooks are shared from main repo
    @if [ -d .git ]; then \
        uv run prek install && \
        if [ -f .git/hooks/pre-commit ]; then \
            sed -i 's|exec "\$$PREK"|exec uv run prek|' .git/hooks/pre-commit; \
        fi; \
    else \
        echo "  Skipping in worktree (hooks shared from main repo)"; \
    fi
    @echo "✅ Pre-commit hooks installed"

## Code Quality

# Format code with ruff
format:
    @echo "🎨 Formatting code..."
    uv run --frozen ruff format .
    @echo "✅ Code formatted"

# Lint code with ruff
lint:
    @echo "🔍 Linting code..."
    uv run --frozen ruff check .

# Lint code and auto-fix issues
lint-fix:
    @echo "🔧 Linting code with auto-fix..."
    uv run --frozen ruff check . --fix

# Run type checking with pyrefly
typecheck:
    @echo "🔍 Running type checker..."
    uv run --frozen pyrefly check

# Check for dependency issues with deptry
deptry:
    @echo "🔍 Checking for dependency issues..."
    uv run --frozen deptry src

# Check cognitive complexity (all functions must be ≤ 15)
complexity:
    @echo "🔍 Checking cognitive complexity..."
    uv run --frozen complexipy src --max-complexity-allowed 15

## Testing

# Run tests affected by recent changes (default, uses testmon)
test:
    @echo "🧪 Running tests affected by changes..."
    uv run --frozen pytest --testmon

# Run all tests (ignores testmon)
test-full:
    @echo "🧪 Running all tests..."
    uv run --frozen pytest

# Rebuild testmon database (run all tests to rebuild dependency map)
test-reset:
    @echo "🧪 Rebuilding testmon dependency database..."
    uv run --frozen pytest --testmon
    @echo "✅ Testmon database rebuilt"

# Run tests with verbose output
test-verbose:
    @echo "🧪 Running tests (verbose)..."
    uv run --frozen pytest -v

# Run tests with coverage report
test-coverage:
    @echo "🧪 Running tests with coverage..."
    uv run --frozen pytest --cov=src --cov-report=term-missing

## Build and Clean

# Build the package
build:
    @echo "🔨 Building package..."
    uv build

# Clean up temporary files and caches
clean:
    @echo "🧹 Cleaning up..."
    find . -type f -name "*.pyc" -delete
    find . -type d -name "__pycache__" -delete
    find . -type d -name "*.egg-info" -exec rm -rf {} +
    find . -type d -name ".pytest_cache" -exec rm -rf {} +
    find . -type d -name ".ruff_cache" -exec rm -rf {} +
    rm -rf dist/
    rm -rf build/
    @echo "✅ Cleanup complete"

## CI/Development Workflow

# Run all code quality checks (lint + typecheck + test-full)
check:
    @echo "🔍 Running all checks..."
    @just lint
    @just typecheck
    @just deptry
    @just complexity
    @just test-full
    @echo "✅ All checks passed"

# Run full CI pipeline (format, lint, typecheck, test-full)
ci:
    @echo "🤖 Running CI pipeline..."
    @just format
    @just lint
    @just typecheck
    @just deptry
    @just complexity
    @just test-full
    @echo "✅ CI pipeline complete"

# Run pre-commit hooks on all files
pre-commit:
    @echo "🪝 Running pre-commit hooks..."
    uv run prek run --all-files

## Development Utilities

# Generate/update CHANGELOG.md from git history (for preview/manual edits)
changelog:
    @echo "📝 Generating changelog..."
    uv run git-cliff -o CHANGELOG.md
    @echo "✅ CHANGELOG.md updated"

# Create a new release (updates changelog, commits, and tags)
# Usage: just release v0.5.0 [--yes]
release VERSION *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail

    # Parse flags
    SKIP_CONFIRM=false
    for flag in {{FLAGS}}; do
        if [[ "$flag" == "--yes" || "$flag" == "-y" ]]; then
            SKIP_CONFIRM=true
        fi
    done

    # Validate version format
    if ! [[ "{{VERSION}}" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "❌ Invalid version format. Use: vX.Y.Z or X.Y.Z"
        exit 1
    fi

    # Ensure version starts with 'v'
    VERSION="{{VERSION}}"
    [[ "$VERSION" =~ ^v ]] || VERSION="v$VERSION"

    # Check for uncommitted changes
    if [[ -n $(git status --porcelain) ]]; then
        echo "❌ Working directory has uncommitted changes. Commit or stash them first."
        exit 1
    fi

    # Check if tag already exists
    if git rev-parse "$VERSION" >/dev/null 2>&1; then
        echo "❌ Tag $VERSION already exists"
        exit 1
    fi

    echo "📝 Creating release $VERSION..."

    # Generate changelog for this version
    echo "  → Generating CHANGELOG.md with version $VERSION..."
    uv run git-cliff --tag "$VERSION" -o CHANGELOG.md

    # Show the changes
    echo ""
    echo "📋 Changelog changes:"
    git diff CHANGELOG.md | head -50
    echo ""

    # Confirm (unless --yes flag)
    if [[ "$SKIP_CONFIRM" != "true" ]]; then
        read -p "Continue with release $VERSION? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            git checkout CHANGELOG.md
            echo "❌ Release cancelled"
            exit 1
        fi
    else
        echo "⚡ Skipping confirmation (--yes flag)"
    fi

    # Commit and tag
    echo "  → Committing changelog..."
    git add CHANGELOG.md
    git commit -m "docs: update changelog for $VERSION"

    echo "  → Creating tag $VERSION..."
    git tag -a "$VERSION" -m "Release $VERSION"

    echo ""
    echo "✅ Release $VERSION created successfully!"
    echo ""
    echo "📤 Next steps:"
    echo "   git push origin $(git branch --show-current)"
    echo "   git push origin $VERSION"

# Auto-bump version and create release (determines version from conventional commits)
# Usage: just release-auto [--yes]
# Version bumping rules:
#   - feat: commits → MINOR bump (v0.4.0 → v0.5.0)
#   - fix: commits → PATCH bump (v0.4.0 → v0.4.1)
#   - BREAKING CHANGE or feat!/fix! → MAJOR bump (v0.4.0 → v1.0.0)
release-auto *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail

    # Check for uncommitted changes
    if [[ -n $(git status --porcelain) ]]; then
        echo "❌ Working directory has uncommitted changes. Commit or stash them first."
        exit 1
    fi

    echo "🔍 Calculating next version from conventional commits..."
    echo "  Rules: feat:→MINOR, fix:→PATCH, BREAKING CHANGE→MAJOR"
    echo ""

    # Get the bumped version (git-cliff returns with 'v' prefix already)
    VERSION=$(uv run git-cliff --bumped-version 2>/dev/null || echo "")

    if [[ -z "$VERSION" ]]; then
        echo "❌ Could not determine next version. Make sure you have:"
        echo "   - At least one previous tag (vX.Y.Z format)"
        echo "   - Unreleased conventional commits (feat:, fix:, etc.)"
        exit 1
    fi
    echo "📦 Next version: $VERSION"
    echo ""

    # Pass flags through to release command
    just release "$VERSION" {{FLAGS}}

# Update all dependencies to latest versions
update-deps:
    @echo "📦 Updating dependencies..."
    uv lock --upgrade

# Generate/update lockfile
lock:
    @echo "🔒 Updating lockfile..."
    uv lock

# Sync environment with lockfile
sync:
    @echo "🔄 Syncing environment..."
    uv sync

## Project Info

# Show project information
info:
    @echo "📊 Project Information:"
    @echo "  Name: {{project_name}}"
    @echo "  Python: $(uv run python --version)"
    @echo "  UV: $(uv --version)"
    @echo "  Git branch: $(git branch --show-current)"
    @echo "  Git status: $(git status --porcelain | wc -l) changed files"
    @echo "  Pre-commit: $(if [ -f .git/hooks/pre-commit ]; then echo 'installed'; else echo 'not installed'; fi)"

# Show dependency tree
deps:
    @echo "📋 Dependency tree:"
    uv tree
